# Environment variables configuration template
# Copy to .env for local deployment - NEVER commit real credentials to version control

# ----------------- Database Configuration -----------------
DATABASE_URL=jdbc:postgresql://localhost:5432/finance_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_password

# ----------------- JWT Security Configuration -----------------
JWT_SECRET=c2VjdXJlLXN1cGVyLXJhbmRvbS1qd3Qtc2VjcmV0LWtleS0yNTYtYml0cy1sb25nLXZhbHVl
JWT_ACCESS_EXPIRATION_MS=900000          # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000      # 7 days

# ----------------- SMS Gateway Configuration -----------------
# Available options: mock, iranian_gateway, kavenegar, farazsms, twilio
SMS_PROVIDER=mock
SMS_API_BASE_URL=https://api.sms-provider.ir/v1
SMS_API_KEY=placeholder_api_key_do_not_hardcode
SMS_API_SECRET=placeholder_api_secret
SMS_USERNAME=placeholder_username
SMS_PASSWORD=placeholder_password
SMS_SENDER=+983000xxxx
SMS_WEBHOOK_SECRET=placeholder_webhook_signing_secret

# Pattern / Template IDs on Provider
SMS_PATTERN_OTP=1001
SMS_PATTERN_INSTALLMENT=1002
SMS_PATTERN_VEHICLE=1003
SMS_PATTERN_GENERAL=1004

# ----------------- Server & Application -----------------
SERVER_PORT=8080
LOG_LEVEL=INFO
APP_CORS_ALLOWED_ORIGINS=*
